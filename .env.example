# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://phase1plus:phase1plus_dev@localhost:5432/phase1plus

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── QR Signing (RS256) ──────────────────────────────────────────────────────────
# Run: pnpm --filter @phase1plus/qr-lib generate-keypair
# Then paste the file contents here (keep newlines as \n)
QR_PRIVATE_KEY_PATH=./keys/private.pem
QR_PUBLIC_KEY_PATH=./keys/public.pem

# ── WhatsApp (Cloud API) ────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Storage ─────────────────────────────────────────────────────────────────────
# AWS S3 or GCP Cloud Storage — TBD in Sprint 0
STORAGE_BUCKET=
STORAGE_REGION=

# ── Payments ────────────────────────────────────────────────────────────────────
# TBD — Stripe or local gateway
STRIPE_SECRET_KEY=

# ── FEL (Guatemala fiscal) ──────────────────────────────────────────────────────
# TBD — InfileGT / Digifact / other
FEL_PROVIDER=
FEL_API_KEY=
FEL_NIT=
