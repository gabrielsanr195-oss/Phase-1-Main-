# Terraform state — never commit; contains secrets and resource IDs
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local variable overrides — contains your real values
terraform.tfvars
*.auto.tfvars

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
